# MongoDB connection string
MONGO_URI=mongodb://user:password@host:27017/typeit

# HTTP port
PORT=3000

# Secret used to sign JWTs. REQUIRED in production (server fails to start without it).
JWT_SECRET=change-me

# Comma-separated list of allowed CORS origins. Optional; when empty the server
# allows localhost on any port and *.devtunnels.ms.
CORS_ORIGINS=

# Google sign-in (all three needed). Keep the secret out of git.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# This server's callback as registered in Google Cloud, e.g. https://example.com/api/auth/google/callback
GOOGLE_REDIRECT_URI=
# Where the browser returns after Google, e.g. https://example.com
CLIENT_URL=http://localhost:4200

# Release notes: compiled weekly from these repos' commit messages (owner/name, comma-separated).
# GITHUB_TOKEN is only needed for private repos: a fine-grained token, read-only "Contents".
GITHUB_CHANGELOG_REPOS=
GITHUB_TOKEN=

# Public contact address on the About page (empty hides the contact options).
CONTACT_EMAIL=

# Accounts given a role by the server itself (comma-separated; accounts must already exist).
# FOUNDER_*: top rank. Nobody can change, ban or delete a founder through the app.
# ADMIN_*: admins, promoted when the server starts (never demoted by it).
# Prefer the *_USER_IDS settings (the account _id in MongoDB): an id cannot be claimed by
# registering a name. Usernames work too, but a name matching more than one account is refused.
FOUNDER_USER_IDS=
ADMIN_USER_IDS=
FOUNDER_USERNAMES=
ADMIN_USERNAMES=
